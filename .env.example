# Configuración general de Django
DEBUG=1
SECRET_KEY=django-insecure-cambiar-por-una-clave-secreta-segura
DJANGO_ALLOWED_HOSTS=* localhost 127.0.0.1 [::1]

# Base de datos (Por defecto SQLite)
ENGINE=django.db.backends.sqlite3
DATABASE_NAME=BASE_DIR / 'db.sqlite3'
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_OPTIONS=

# Ejemplo para Microsoft SQL Server (mssql):
# ENGINE=mssql
# DATABASE_NAME=bancoo
# DATABASE_USER=sa
# DATABASE_PASSWORD=tu_contraseña
# DATABASE_HOST=localhost\SQLEXPRESS
# DATABASE_PORT=1433
